{
  "name": "tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "A modern React Tic Tac Toe game with improved UI/UX",
  "keywords": [
    "react",
    "game",
    "tic-tac-toe",
    "typescript"
  ],
  "author": "Wilberto Pacheco Batista",
  "license": "MIT",
  "dependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,scss,json,md}",
    "format:check": "prettier --check src/**/*.{js,jsx,ts,tsx,css,scss,json,md}",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "deploy": "./deploy.sh",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name=tic-tac-toe-app",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop tic-tac-toe-app",
    "pm2:restart": "pm2 restart tic-tac-toe-app",
    "pm2:logs": "pm2 logs tic-tac-toe-app",
    "pm2:status": "pm2 status"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:jsx-a11y/recommended",
      "prettier"
    ],
    "plugins": [
      "react",
      "react-hooks",
      "jsx-a11y"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "rules": {
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn",
      "no-undef": "off"
    },
    "overrides": [
      {
        "files": [
          "*.ts",
          "*.tsx"
        ],
        "parser": "@typescript-eslint/parser",
        "plugins": [
          "@typescript-eslint"
        ],
        "extends": [
          "plugin:@typescript-eslint/recommended"
        ],
        "rules": {
          "no-undef": "off"
        }
      },
      {
        "files": [
          "*.test.js",
          "*.test.ts",
          "*.test.tsx"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2
  }
}
